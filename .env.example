# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JULES_API_KEY: Required for real Google Jules API (v1alpha) integration.
# Stored strictly server-side in Node/Express proxy and sent via X-Goog-Api-Key header.
# Never expose this key to client-side frontend code.
JULES_API_KEY="YOUR_JULES_API_KEY_HERE"

# APP_URL: Hosted applet URL injected by AI Studio at runtime.
APP_URL="MY_APP_URL"
PORT=3000
